# Copy to .env. Never commit .env or paste your key into chat.
PORT=3000
AI_API_KEY=replace_with_your_openrouter_key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
# Optional web research provider. Create a key at https://tavily.com/
TAVILY_API_KEY=
# Optional: set a long random value to protect server-side admin endpoints if added later.
APP_SECRET=
