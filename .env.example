# Copy to .env for local development. Never commit .env or paste secrets into chat.
PORT=3000
AI_API_KEY=replace_with_your_openrouter_api_key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
APP_URL=https://banana-ai-assistant.vercel.app
# Required for private account sessions and private Vercel Blob persistence in production.
SESSION_SECRET=replace_with_a_long_random_secret
BLOB_READ_WRITE_TOKEN=replace_with_your_private_vercel_blob_token
# Optional web research provider. Without this, the app attempts public DuckDuckGo search.
TAVILY_API_KEY=
